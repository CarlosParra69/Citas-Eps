		{
			"name": "🔐 Autenticación JWT",
			"item": [
				{
					"name": "Registro Paciente",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"nombre\": \"Juan\",\n    \"apellido\": \"Pérez\",\n    \"cedula\": \"1234567890\",\n    \"fecha_nacimiento\": \"1990-01-01\",\n    \"genero\": \"M\",\n    \"telefono\": \"3001234567\",\n    \"email\": \"juan.perez@test.com\",\n    \"direccion\": \"Calle 123 #45-67\",\n    \"eps\": \"Sura EPS\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/register",
							"host": ["{{base_url}}"],
							"path": ["auth", "register"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    const response = pm.response.json();",
									"    if (response.success && response.data.access_token) {",
									"        pm.collectionVariables.set('jwt_token', response.data.access_token);",
									"        console.log('✅ Token JWT guardado automáticamente');",
									"        console.log('Token expira en:', response.data.expires_in, 'segundos');",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Login Paciente",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"cedula\": \"1234567890\",\n    \"email\": \"juan.perez@test.com\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": ["{{base_url}}"],
							"path": ["auth", "login"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    if (response.success && response.data.access_token) {",
									"        pm.collectionVariables.set('jwt_token', response.data.access_token);",
									"        console.log('✅ Login exitoso - Token JWT guardado');",
									"        console.log('Token expira en:', response.data.expires_in, 'segundos');",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					]
				},
